<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:orientation="vertical">

    <!-- Top bar: sessions · title+meta · diff · new · overflow -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_base"
        android:orientation="vertical"
        android:paddingBottom="2dp">

        <LinearLayout
            android:id="@+id/toolbar_row"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="2dp"
            android:paddingEnd="2dp">

            <ImageButton
                android:id="@+id/btn_sessions"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_sessions"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_history"
                android:tint="@color/text_secondary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="6dp">

                <TextView
                    android:id="@+id/session_title"
                    style="@style/ToolbarTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name" />

                <TextView
                    android:id="@+id/session_meta"
                    style="@style/MonoMetaText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:maxLines="1"
                    android:text="@string/status_connecting"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/diff_badge"
                style="@style/MonoMetaText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_diff_badge"
                android:paddingStart="7dp"
                android:paddingTop="3dp"
                android:paddingEnd="7dp"
                android:paddingBottom="3dp"
                android:textSize="10.5sp"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btn_new_session"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_new_session"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_add"
                android:tint="@color/text_secondary" />

            <ImageButton
                android:id="@+id/btn_overflow"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_more"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_more_vert"
                android:tint="@color/text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/reconnect_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="2dp"
        android:background="@drawable/bg_notice_card"
        android:orientation="horizontal"
        android:visibility="gone">

        <View
            android:id="@+id/reconnect_accent"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:background="@color/notice_error" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/reconnect_icon"
                    style="@style/MonoMetaText"
                    android:layout_width="18dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="!"
                    android:textColor="@color/notice_error"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/reconnect_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/notice_title_connector"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/reconnect_text"
                style="@style/MonoMetaText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="3dp"
                android:text="@string/reconnect_banner"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/reconnect_btn"
                style="@style/MonoMetaText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_notice_action"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:text="@string/reconnect_action"
                android:textColor="@color/pi_blue"
                android:textSize="11.5sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/messages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingTop="2dp"
            android:paddingBottom="10dp" />

        <ImageButton
            android:id="@+id/scroll_bottom"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_scroll_bottom"
            android:contentDescription="@string/scroll_to_bottom"
            android:elevation="2dp"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_scroll_down"
            android:tint="@color/text_secondary"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:alpha="0.9"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_pi_logo" />

            <TextView
                android:id="@+id/empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/empty_title"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/empty_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.25"
                android:text="@string/empty_body"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/empty_action"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/empty_open_settings"
                android:textColor="@color/pi_blue"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/suggest_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="vertical" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/slash_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_slash_panel"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="2dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="2dp"
            android:text="@string/slash_hint_title"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/slash_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />
    </LinearLayout>

    <!-- Extension / approval card -->
    <LinearLayout
        android:id="@+id/actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_approval_card"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/actions_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/pi_amber"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/actions_body"
            style="@style/MonoMetaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_tool_output"
            android:maxLines="8"
            android:padding="8dp"
            android:scrollHorizontally="false"
            android:textColor="@color/text_secondary"
            android:textIsSelectable="true"
            android:textSize="11.5sp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/actions_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_composer"
            android:hint=""
            android:maxLines="5"
            android:padding="10dp"
            android:scrollHorizontally="false"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/actions_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:orientation="horizontal" />
    </LinearLayout>

    <TextView
        android:id="@+id/generation_status"
        style="@style/MonoMetaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="14dp"
        android:paddingTop="1dp"
        android:paddingEnd="14dp"
        android:paddingBottom="1dp"
        android:textColor="@color/text_muted"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- Composer card -->
    <LinearLayout
        android:id="@+id/composer_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="2dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_composer_card"
            android:orientation="vertical"
            android:paddingStart="2dp"
            android:paddingTop="4dp"
            android:paddingEnd="2dp"
            android:paddingBottom="4dp">

            <HorizontalScrollView
                android:id="@+id/attachment_scroller"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="2dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/attachment_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <EditText
                android:id="@+id/composer"
                style="@style/ComposerText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:hint="@string/hint_message"
                android:imeOptions="actionNone|flagNoExtractUi"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="6"
                android:minHeight="36dp"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="2dp" />

            <!-- attach · chip(shrink) · Plan/Steer/Queue · stop · send — fits 360dp -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="2dp"
                android:paddingEnd="4dp">

                <ImageButton
                    android:id="@+id/btn_attach"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_attach"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_attach"
                    android:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/model_chip"
                    style="@style/MonoMetaText"
                    android:layout_width="0dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_status_chip"
                    android:clickable="true"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:minWidth="36dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:singleLine="true"
                    android:text="@string/action_model"
                    android:textColor="@color/pi_blue"
                    android:textSize="10.5sp" />

                <LinearLayout
                    android:id="@+id/steer_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/bg_segmented"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/steer_mode_plan"
                        style="@style/MonoMetaText"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:text="@string/composer_plan"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/steer_mode_steer"
                        style="@style/MonoMetaText"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_segmented_on"
                        android:gravity="center"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:text="@string/composer_steer"
                        android:textColor="@color/md_theme_onPrimary"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/steer_mode_queue"
                        style="@style/MonoMetaText"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:text="@string/composer_queue"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btn_stop"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_stop"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_stop"
                    android:tint="@color/status_offline"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/send"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_send_button"
                    android:contentDescription="@string/action_send"
                    android:padding="7dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_send"
                    android:tint="@color/md_theme_onPrimary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tiny footer: single line; long status/stats ellipsize -->
        <LinearLayout
            android:id="@+id/status_footer"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="0dp"
            android:paddingEnd="6dp"
            android:paddingBottom="0dp">

            <View
                android:id="@+id/status_dot"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:background="@drawable/ic_status_dot" />

            <TextView
                android:id="@+id/status_text"
                style="@style/MonoMetaText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:text="@string/status_connecting"
                android:textColor="@color/text_muted"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/footer_sep"
                style="@style/MonoMetaText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="·"
                android:textColor="@color/text_faint"
                android:textSize="10.5sp"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/context_bar_wrap"
                android:layout_width="28dp"
                android:layout_height="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_context_bar_track"
                android:visibility="gone">

                <View
                    android:id="@+id/context_bar_fill"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_context_bar_fill" />
            </FrameLayout>

            <TextView
                android:id="@+id/footer_stats"
                style="@style/MonoMetaText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="160dp"
                android:singleLine="true"
                android:textColor="@color/text_faint"
                android:textSize="10.5sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Kept for code that finds status_chip; hidden -->
    <View
        android:id="@+id/status_chip"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</LinearLayout>
