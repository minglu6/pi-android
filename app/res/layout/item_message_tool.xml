<?xml version="1.0" encoding="utf-8"?>
<!-- Dense tool timeline row — latest turn expanded by default -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="1dp"
    android:paddingEnd="14dp"
    android:paddingBottom="1dp">

    <LinearLayout
        android:id="@+id/tool_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:background="?attr/selectableItemBackground"
        android:minHeight="28dp"
        android:orientation="vertical"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <LinearLayout
            android:id="@+id/tool_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/tool_state_bar"
                android:layout_width="2dp"
                android:layout_height="14dp"
                android:layout_marginEnd="8dp"
                android:background="@color/text_muted" />

            <TextView
                android:id="@+id/tool_glyph"
                style="@style/MonoMetaText.Line"
                android:layout_width="16dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tool_name"
                style="@style/MonoMetaText.Line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/tool_subject"
                style="@style/MonoMetaText.Line"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:singleLine="true"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tool_diff"
                style="@style/MonoMetaText.Line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:maxLines="1"
                android:textSize="10.5sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tool_status"
                style="@style/MonoMetaText.Line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:textColor="@color/text_muted"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/tool_chevron"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="@color/text_faint"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tool_output_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="4dp"
            android:orientation="vertical"
            android:visibility="gone">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true"
                android:overScrollMode="ifContentScrolls"
                android:scrollbars="horizontal">

                <TextView
                    android:id="@+id/tool_command"
                    style="@style/MonoMetaText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tool_output"
                    android:breakStrategy="simple"
                    android:lineSpacingMultiplier="1.2"
                    android:maxLines="8"
                    android:padding="6dp"
                    android:textColor="@color/status_online"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </HorizontalScrollView>

            <androidx.core.widget.NestedScrollView
                android:id="@+id/tool_output_vscroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fillViewport="false"
                android:overScrollMode="ifContentScrolls"
                android:scrollbars="vertical">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fillViewport="true"
                    android:overScrollMode="ifContentScrolls"
                    android:scrollbars="horizontal">

                    <TextView
                        android:id="@+id/tool_output"
                        style="@style/MonoMetaText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_tool_output"
                        android:breakStrategy="simple"
                        android:lineSpacingMultiplier="1.25"
                        android:padding="6dp"
                        android:textColor="@color/text_secondary"
                        android:textIsSelectable="true"
                        android:textSize="11sp" />
                </HorizontalScrollView>
            </androidx.core.widget.NestedScrollView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tool_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/tool_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center_vertical"
                android:minHeight="28dp"
                android:paddingStart="2dp"
                android:paddingEnd="8dp"
                android:textColor="@color/pi_blue"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tool_copy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center_vertical"
                android:minHeight="28dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/tool_copy_output"
                android:textColor="@color/pi_blue"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tool_stop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/shell_stop_cd"
                android:gravity="center_vertical"
                android:minHeight="28dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/shell_stop"
                android:textColor="@color/status_offline"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
