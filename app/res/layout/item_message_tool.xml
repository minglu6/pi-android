<?xml version="1.0" encoding="utf-8"?>
<!--
  工具调用卡片：参照 pi-pocket web transcript.js 的 ToolStep / .shell-card —
  头部一行元数据（状态条 + glyph + 名称 + 主题 + 状态 + 展开箭头），
  命令/输出为等宽 plaintext 块，横向滚动保留长路径；
  默认 6 行预览，可展开/折叠/复制（逻辑见 MessageAdapter.bindTool）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="54dp"
    android:paddingTop="4dp"
    android:paddingEnd="16dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:id="@+id/tool_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_tool_card"
        android:orientation="horizontal"
        android:padding="@dimen/tool_card_padding">

        <View
            android:id="@+id/tool_state_bar"
            android:layout_width="@dimen/tool_state_bar_width"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/tool_output_padding"
            android:background="@color/text_muted" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/tool_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="@string/tool_card_cd"
                android:gravity="center_vertical"
                android:minHeight="44dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tool_glyph"
                    android:layout_width="18dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/meslo_lgldz_nf_regular"
                    android:gravity="center"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/tool_header_text" />

                <TextView
                    android:id="@+id/tool_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:maxWidth="140dp"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/tool_header_text"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tool_subject"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/tool_meta_text" />

                <TextView
                    android:id="@+id/tool_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:maxLines="1"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/tool_meta_text" />

                <TextView
                    android:id="@+id/tool_chevron"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/tool_meta_text" />
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/tool_output_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:scrollbars="horizontal"
                android:requiresFadingEdge="horizontal"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tool_command"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_tool_output"
                        android:fontFamily="@font/meslo_lgldz_nf_regular"
                        android:lineSpacingMultiplier="1.25"
                        android:padding="@dimen/tool_output_padding"
                        android:scrollHorizontally="true"
                        android:textColor="@color/status_online"
                        android:textSize="@dimen/tool_output_text"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tool_output"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_tool_output"
                        android:fontFamily="@font/meslo_lgldz_nf_regular"
                        android:lineSpacingMultiplier="1.3"
                        android:padding="@dimen/tool_output_padding"
                        android:scrollHorizontally="true"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/tool_output_text" />
                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/tool_footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tool_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:gravity="center_vertical"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:paddingStart="2dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="6dp"
                    android:textColor="@color/pi_blue"
                    android:textSize="@dimen/tool_meta_text" />

                <TextView
                    android:id="@+id/tool_copy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:gravity="center_vertical"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:paddingStart="8dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="6dp"
                    android:text="@string/tool_copy_output"
                    android:textColor="@color/pi_blue"
                    android:textSize="@dimen/tool_meta_text" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
