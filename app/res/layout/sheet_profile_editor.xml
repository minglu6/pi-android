<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_elevated"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_drag_handle" />

    <TextView
        android:id="@+id/profile_editor_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        android:text="@string/profiles_edit_title"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/SettingsLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="0dp"
                android:text="@string/profiles_field_name" />

            <EditText
                android:id="@+id/profile_name"
                style="@style/SettingsField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/profiles_field_name_hint"
                android:inputType="text" />

            <TextView
                style="@style/SettingsLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_host_label" />

            <EditText
                android:id="@+id/profile_host"
                style="@style/SettingsField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/profiles_host_hint"
                android:inputType="textUri" />

            <TextView
                style="@style/SettingsLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_port_label" />

            <EditText
                android:id="@+id/profile_port"
                style="@style/SettingsField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />

            <TextView
                style="@style/SettingsLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_token_label" />

            <EditText
                android:id="@+id/profile_token"
                style="@style/SettingsField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/settings_token_hint"
                android:inputType="textPassword" />

            <TextView
                style="@style/SettingsLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profiles_field_cwd" />

            <EditText
                android:id="@+id/profile_cwd"
                style="@style/SettingsField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/profiles_field_cwd_hint"
                android:inputType="textUri" />

            <TextView
                android:id="@+id/profile_remote_warn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/profiles_remote_warn"
                android:textColor="@color/pi_amber"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/profile_delete"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="@string/profiles_delete"
            android:textColor="@color/pi_salmon"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/profile_save"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="@string/profiles_save"
            android:textColor="@color/pi_blue"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
