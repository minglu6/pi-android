<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bg_elevated"
        android:elevation="2dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:text="@string/unofficial_notice"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <TextView
                style="@style/SettingsLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_host_label" />

            <EditText
                android:id="@+id/host"
                style="@style/SettingsField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/settings_host_hint"
                android:inputType="textUri"
                android:importantForAutofill="no" />

            <TextView
                style="@style/SettingsLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_port_label" />

            <EditText
                android:id="@+id/port"
                style="@style/SettingsField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:importantForAutofill="no" />

            <TextView
                style="@style/SettingsLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_token_label" />

            <EditText
                android:id="@+id/token"
                style="@style/SettingsField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/settings_token_hint"
                android:inputType="textVisiblePassword"
                android:importantForAutofill="no" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/settings_help"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
